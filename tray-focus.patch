+            trayItem.activate();
+            return;
+        }
+        Proc.runCommand("tray-focus-" + trayItem.id,
+            [helper, trayItem.id], (output, exitCode) => {
+                if (exitCode !== 0)
+                    trayItem.activate();
+            }, 0, 10000);
+    }
